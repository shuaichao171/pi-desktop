{
  "name": "pi-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop workbench for the Pi coding agent (Electron + React), inspired by ZCode's architecture",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pidesktop/desktop dev",
    "build": "pnpm --filter @pidesktop/desktop build",
    "pack:dir": "pnpm --filter @pidesktop/desktop pack:dir",
    "dist:win": "pnpm --filter @pidesktop/desktop dist:win",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean"
  }
}
