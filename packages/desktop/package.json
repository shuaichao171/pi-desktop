{
  "name": "@pidesktop/desktop",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "description": "Desktop workbench for the Pi coding agent",
  "author": "Pi Desktop contributors",
  "homepage": "https://github.com/shuaichao171/pi-desktop",
  "desktopName": "pi-desktop.desktop",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node ../../scripts/prepare-update-config.mjs",
    "pack:dir": "pnpm build && node ../../scripts/dist-win.mjs --dir",
    "dist:win": "node ../../scripts/make-portable-splash.mjs && pnpm build && node ../../scripts/dist-win.mjs",
    "dist:mac": "node ../../scripts/dist-mac-native.mjs",
    "dist:linux": "pnpm build && node ../../scripts/dist-linux.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "clean": "rimraf out dist"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@pidesktop/agent": "workspace:*",
    "@pidesktop/shared": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2"
  },
  "devDependencies": {
    "@pidesktop/ui": "workspace:*",
    "@electron/asar": "4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
