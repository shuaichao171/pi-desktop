{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@pidesktop/shared": ["../../packages/shared/src/index.ts"],
      "@pidesktop/shared/*": ["../../packages/shared/src/*.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/shared/src/remoteAccess.ts",
    "../../packages/shared/src/remoteClient.ts"
  ]
}
